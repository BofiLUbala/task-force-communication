# Task Force Présidentielle — backend production environment.
#
# Copy the keys into the hosting provider's environment settings. Never commit
# a filled-in copy: real values belong in the provider's secret store only.
# Replace <domain> with the real domain everywhere it appears.

# --- Core -----------------------------------------------------------------
DEBUG=False
# Generate once, keep secret:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
# Hostname(s) only — no scheme, no trailing slash.
ALLOWED_HOSTS=api.<domain>

# --- URLs -----------------------------------------------------------------
# Where the SPA lives. Used for OAuth return redirects and for the public
# publication links that travel into e-mails, WhatsApp and social posts.
FRONTEND_URL=https://<domain>

# --- Browser security -----------------------------------------------------
# Exact scheme+host, comma separated. Never "*" in production.
CORS_ALLOWED_ORIGINS=https://<domain>
# Required for the Django admin login and any cookie-authenticated POST.
CSRF_TRUSTED_ORIGINS=https://<domain>,https://api.<domain>
# Leave unset unless the platform already redirects HTTP→HTTPS at its edge,
# in which case SECURE_SSL_REDIRECT=False avoids a redirect loop.
# SECURE_SSL_REDIRECT=True

# --- Database -------------------------------------------------------------
# Managed Postgres hands out a single URL. Most providers require TLS.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# DB_CONN_MAX_AGE=60

# --- Uploads --------------------------------------------------------------
# REQUIRED on any platform with an ephemeral filesystem, otherwise every
# uploaded image, video and PDF disappears on the next deploy. Point at
# Cloudflare R2 or any S3-compatible bucket. Leave empty ONLY when MEDIA_ROOT
# is a real persistent volume.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Public hostname serving the bucket, so media URLs are clean and cacheable.
AWS_S3_CUSTOM_DOMAIN=media.<domain>
# Only used when object storage is disabled; must be a persistent volume.
# MEDIA_ROOT=/var/data/media

# --- E-mail ---------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Task Force Présidentielle <no-reply@<domain>>
CONTACT_EMAIL=contact@<domain>

# --- OAuth ----------------------------------------------------------------
# Callbacks are derived from this base; it must be the API host over HTTPS.
SOCIAL_AUTH_REDIRECT_BASE=https://api.<domain>
# Optional exact overrides (must match the provider console character for
# character). Leave empty to use the base above.
GOOGLE_OAUTH_REDIRECT_URI=https://api.<domain>/api/social-accounts/oauth/youtube/callback/
LINKEDIN_OAUTH_REDIRECT_URI=https://api.<domain>/api/social-accounts/oauth/linkedin/callback/

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Keep 'unlisted' until the production upload has been verified end to end,
# then switch to 'public' if that is the intended business rule.
YOUTUBE_PRIVACY_STATUS=unlisted

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# urn:li:organization:<id> — leave empty to publish as the member instead.
LINKEDIN_ORGANIZATION_URN=

# --- WhatsApp (optional) --------------------------------------------------
OPENWA_ENABLED=False
OPENWA_API_URL=
OPENWA_API_KEY=

# --- Push -----------------------------------------------------------------
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
